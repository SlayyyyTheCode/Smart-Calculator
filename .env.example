# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase --------------------------------------------------------------
# Project settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security, so it is used solely by the cron
# route handlers and must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
# Where auth redirects come back to. Leave unset on Vercel; it derives from
# VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
