# Copy to keystore.properties and fill in. Never commit the real one, and never
# commit the .jks it points at — both are gitignored for that reason.
#
# Generate the key first. It is yours to keep, and keeping it is the whole job:
# Google Play binds your listing to this key, so losing it means you can no
# longer publish updates to your own app. Back the .jks up somewhere that is not
# this laptop.
#
#   keytool -genkeypair -v \
#     -keystore upload-keystore.jks \
#     -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12
#
# 10000 days is the conventional validity because an expired upload key is the
# same problem as a lost one.

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
